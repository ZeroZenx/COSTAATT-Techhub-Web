# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Database (PostgreSQL)
DATABASE_URL=postgresql://techhub:techhub_password@localhost:5432/techhub?schema=public

# Internal access controls
# Comma-separated list of allowed email domains (optional)
ALLOWED_EMAIL_DOMAINS=costaatt.edu.tt

# Optional: restrict to campus IP ranges (if behind reverse proxy, configure X-Forwarded-For correctly)
# ALLOWED_IP_RANGES=192.168.0.0/16,10.0.0.0/8
